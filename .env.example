# AirflowHome provider credentials
#
# Copy this file to .env.local for local provider feasibility work.
# .env.local is gitignored. Never commit real keys.
#
# Provider credentials are NOT required for npm run verify.

# Kakao Map Web SDK (browser key; restrict to registered domains in Kakao settings)
VITE_KAKAO_MAP_JS_KEY=

# Kakao REST API key for address/coordinate feasibility tests.
# Treat as a secret and keep it out of client bundles.
KAKAO_REST_API_KEY=

# Ministry of the Interior and Safety Address-based Industry Support Service.
JUSO_CONFIRM_KEY=

# Public Data Portal service key.
# Candidate services using this key include KMA, BuildingHUB, and AirKorea
# after each API usage application/approval is enabled for the account.
DATA_GO_KR_SERVICE_KEY=

# VWorld Open API key for GIS/WFS building feasibility tests.
VWORLD_API_KEY=
